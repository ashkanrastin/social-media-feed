# Construct once at the edge

Dependency injection is separating construction from behavior, not a framework. `createX(dependencies)` returns the behavior function. Pass a named object, not a growing positional list. `src/main.ts` and `src/composition/` wire real adapters. Do not `new` Alpaca or IG inside business functions, and do not import those clients in the happy zone. Tests use the same factory. See tests-use-same-factory.mdc.

```typescript
import { err, type Result } from 'true-myth/result';

type SubmitOrder = (symbol: string) => Promise<Result<void, string>>;

// ❌ Positional deps. Happy zone imports and constructs Alpaca.
import { AlpacaClient } from './alpaca-client';

async function placeOrder(symbol: string, logger: Logger): Promise<Result<void, string>> {
    const client = new AlpacaClient();
    logger.info('submitting');
    return client.submit(symbol);
}

// ✅ Factory closes over named collaborators. Call sites pass only the input.
type PlaceOrderDependencies = {
    readonly submitOrder: SubmitOrder;
};

function createPlaceOrder(dependencies: PlaceOrderDependencies) {
    return function placeOrder(symbol: string): Promise<Result<void, string>> {
        if (symbol.length === 0) {
            return Promise.resolve(err('missingSymbol'));
        }
        return dependencies.submitOrder(symbol);
    };
}

// src/composition
createPlaceOrder({ submitOrder: alpaca.submitOrder });
```
