---
description: Separate business decisions from side effects; assert observable behavior, not helper calls
alwaysApply: true
---

# Test decisions, not internal conversations

When a function both decides and talks to a database, mailer, or broker, tests either intercept collaborators or assert that helper A called helper B. Those tests fail when you rename a function even though users see the same outcome.

Put the decision in a pure function. Return events, a True Myth `Result`, or a semantic outcome. Run effects at the boundary. Wire those effect handlers with `createX` as in factory-functions.mdc.

Assert what became true: the return value, stored state, or an interaction that is the product behavior (an order submitted once). Do not assert call counts on internal helpers.

```typescript
import assert from 'node:assert';
import { ok } from 'true-myth/result';

// ❌ Decision mixed with effects. Tests spy on logger.info or db.save.
async function registerUser(email: string, db: Database, mailer: Mailer) {
    const user = await db.save({ email });
    await mailer.sendWelcomeEmail(email);
    return user;
}

// ✅ Decision is pure. Mocha asserts the value, not a helper.
function decideUserRegistration(email: string) {
    return ok({ type: 'UserRegistered', email });
}

suite('registration decision', function () {
    test('emits UserRegistered', function () {
        const result = decideUserRegistration('test@example.com');
        assert.deepStrictEqual(result.unwrapOr({ type: '', email: '' }), {
            type: 'UserRegistered',
            email: 'test@example.com'
        });
    });
});
```
