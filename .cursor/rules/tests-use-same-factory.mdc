# Tests use the same factory

Production and tests both call `createX({ ... })`. Tests pass stubs and fakes. The composition root passes real adapters. Do not build a different graph, and do not intercept modules. See no-module-mocking.mdc and factory-functions.mdc.

```typescript
import assert from 'node:assert';
import { nothing } from 'true-myth/maybe';

// ❌ Test new's Alpaca. Construction is not createLoadQuote.
suite('loadQuote', function () {
    test('loads', async function () {
        const quote = await loadQuote('AAPL', new AlpacaClient());
        assert.strictEqual(quote.isJust, true);
    });
});

// ✅ Same factory as production. Stub owns absence. Mocha asserts the Maybe.
suite('loadQuote', function () {
    test('returns nothing when the broker has no quote', async function () {
        async function findQuote() {
            return nothing();
        }

        const loadQuote = createLoadQuote({ findQuote });
        const quote = await loadQuote('AAPL');
        assert.strictEqual(quote.isNothing, true);
    });
});
```
