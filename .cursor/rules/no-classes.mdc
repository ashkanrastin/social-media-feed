description: Use functions and createX factories; do not declare or express a class
alwaysApply: true
---

# No classes

This is a Node TypeScript flip-on-break bot. Behavior is a function. Construction is `createX({ ... })` at the composition root. A `class` hides that split behind a constructor, `this`, and `new`.

Do not write `class` declarations or `class` expressions. Plain objects hold data. Functions decide. Factories close over named collaborators. See factory-functions.mdc.

```typescript
type SubmitOrder = (symbol: string) => Promise<void>;

// ❌ Constructor, this, and new. Callers construct instead of calling.
class PlaceOrder {
    constructor(private readonly submitOrder: SubmitOrder) {}

    place(symbol: string): Promise<void> {
        return this.submitOrder(symbol);
    }
}

new PlaceOrder(alpaca.submitOrder).place('AAPL');

// ✅ Factory returns the behavior. Call sites pass only the input.
function createPlaceOrder(dependencies: { readonly submitOrder: SubmitOrder }) {
    return function placeOrder(symbol: string): Promise<void> {
        return dependencies.submitOrder(symbol);
    };
}

createPlaceOrder({ submitOrder: alpaca.submitOrder })('AAPL');
```
