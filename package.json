{
  "name": "social-media-feed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "true-myth": "^9.4.0"
  },
  "devDependencies": {
    "@enormora/eslint-config-base": "^0.0.67",
    "@enormora/eslint-config-base-with-prettier": "^0.0.34",
    "@enormora/eslint-config-browser": "^0.0.37",
    "@enormora/eslint-config-react-tsx": "^0.0.66",
    "@enormora/eslint-config-typescript": "^0.0.75",
    "@enormora/eslint-config-vitest-node-assert": "^0.0.22",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
